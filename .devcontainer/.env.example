# Copy this file to `.env` and fill in your values.
# `.devcontainer/.env` is gitignored — never commit real secrets.
#
# The file must exist before opening the project as a Dev Container in VS Code:
# devcontainer.json always passes `--env-file`, so an empty copy is required
# even when no value is set.

# GitHub personal access token (scopes: repo, workflow) used by the `gh` CLI
# inside the devcontainer for Actions logs and pull requests.
GH_TOKEN=
